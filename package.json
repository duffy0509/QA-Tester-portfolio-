{
  "name": "saucedemo-playwright-qa",
  "version": "1.0.0",
  "private": true,
  "description": "QA portfolio: manual test design, bug reports and Playwright + TypeScript automation for saucedemo.com",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.19.43",
    "typescript": "~5.6.3"
  }
}
